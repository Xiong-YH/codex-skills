{
  "$defs": {
    "AssetChoice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "asset": {
          "title": "Asset",
          "type": "string"
        }
      },
      "required": [
        "id",
        "asset"
      ],
      "title": "AssetChoice",
      "type": "object"
    },
    "Bgm": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "default": "bgm",
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Ref"
        },
        "end": {
          "$ref": "#/$defs/Ref"
        },
        "gain": {
          "default": 0.18,
          "maximum": 1,
          "minimum": 0,
          "title": "Gain",
          "type": "number"
        },
        "loop": {
          "default": true,
          "title": "Loop",
          "type": "boolean"
        },
        "trimStartSeconds": {
          "default": 0,
          "minimum": 0,
          "title": "Trimstartseconds",
          "type": "number"
        },
        "fadeInFrames": {
          "default": 60,
          "minimum": 0,
          "title": "Fadeinframes",
          "type": "integer"
        },
        "fadeOutFrames": {
          "default": 90,
          "minimum": 0,
          "title": "Fadeoutframes",
          "type": "integer"
        },
        "speechDuck": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Speechduck",
          "type": "number"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "artist": {
          "default": "",
          "title": "Artist",
          "type": "string"
        },
        "sourceUrl": {
          "default": "",
          "title": "Sourceurl",
          "type": "string"
        },
        "licenseUrl": {
          "default": "",
          "title": "Licenseurl",
          "type": "string"
        },
        "changes": {
          "default": "",
          "title": "Changes",
          "type": "string"
        }
      },
      "required": [
        "file",
        "at",
        "end"
      ],
      "title": "Bgm",
      "type": "object"
    },
    "MediaSource": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "kind": {
          "default": "image",
          "enum": [
            "image",
            "video"
          ],
          "title": "Kind",
          "type": "string"
        },
        "fit": {
          "default": "cover",
          "enum": [
            "cover",
            "contain"
          ],
          "title": "Fit",
          "type": "string"
        },
        "anchorX": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchorx",
          "type": "number"
        },
        "anchorY": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchory",
          "type": "number"
        },
        "dim": {
          "default": 0,
          "maximum": 0.85,
          "minimum": 0,
          "title": "Dim",
          "type": "number"
        },
        "trimStartSeconds": {
          "default": 0,
          "minimum": 0,
          "title": "Trimstartseconds",
          "type": "number"
        },
        "shortage": {
          "default": "error",
          "enum": [
            "error",
            "hold"
          ],
          "title": "Shortage",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "MediaSource",
      "type": "object"
    },
    "Motion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "recipe": {
          "title": "Recipe",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/Ref"
        },
        "durationFrames": {
          "exclusiveMinimum": 0,
          "title": "Durationframes",
          "type": "integer"
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "id",
        "recipe",
        "target",
        "start",
        "durationFrames"
      ],
      "title": "Motion",
      "type": "object"
    },
    "Narration": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Ref"
        },
        "gain": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0,
          "title": "Gain",
          "type": "number"
        }
      },
      "required": [
        "id",
        "file",
        "at"
      ],
      "title": "Narration",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "properties": {
        "fps": {
          "const": 60,
          "default": 60,
          "title": "Fps",
          "type": "integer"
        },
        "width": {
          "const": 1920,
          "default": 1920,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "const": 1080,
          "default": 1080,
          "title": "Height",
          "type": "integer"
        },
        "nativeWidth": {
          "const": 320,
          "default": 320,
          "title": "Nativewidth",
          "type": "integer"
        },
        "nativeHeight": {
          "const": 180,
          "default": 180,
          "title": "Nativeheight",
          "type": "integer"
        }
      },
      "title": "Output",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*\\.[a-zA-Z][a-zA-Z0-9_-]*$",
          "title": "Event",
          "type": "string"
        },
        "offsetFrames": {
          "default": 0,
          "title": "Offsetframes",
          "type": "integer"
        }
      },
      "required": [
        "event"
      ],
      "title": "Ref",
      "type": "object"
    },
    "ShotPlan": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actor"
        },
        "objects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssetChoice"
          },
          "title": "Objects",
          "type": "array"
        },
        "motions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Motion"
          },
          "title": "Motions",
          "type": "array"
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replacement": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "actor"
      ],
      "title": "ShotPlan",
      "type": "object"
    },
    "Sound": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sound": {
          "title": "Sound",
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Ref"
        },
        "level": {
          "maximum": 1,
          "minimum": 0,
          "title": "Level",
          "type": "number"
        },
        "x": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "variant": {
          "default": 0,
          "minimum": 0,
          "title": "Variant",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "sound",
        "at",
        "level"
      ],
      "title": "Sound",
      "type": "object"
    },
    "TextPlan": {
      "additionalProperties": false,
      "properties": {
        "cueId": {
          "title": "Cueid",
          "type": "string"
        },
        "role": {
          "enum": [
            "subtitle",
            "annotation",
            "title",
            "label"
          ],
          "title": "Role",
          "type": "string"
        },
        "accent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accent"
        },
        "x": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "required": [
        "cueId",
        "role"
      ],
      "title": "TextPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "renderBackend": {
      "default": "canvas",
      "enum": [
        "canvas",
        "remotion"
      ],
      "title": "Renderbackend",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/Output"
    },
    "style": {
      "title": "Style",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "audioMode": {
      "enum": [
        "sfx-only",
        "narration+sfx",
        "silent"
      ],
      "title": "Audiomode",
      "type": "string"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/ShotPlan"
      },
      "minItems": 1,
      "title": "Shots",
      "type": "array"
    },
    "text": {
      "items": {
        "$ref": "#/$defs/TextPlan"
      },
      "minItems": 1,
      "title": "Text",
      "type": "array"
    },
    "audio": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Sound"
      },
      "title": "Audio",
      "type": "array"
    },
    "narration": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Narration"
      },
      "title": "Narration",
      "type": "array"
    },
    "bgm": {
      "anyOf": [
        {
          "$ref": "#/$defs/Bgm"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "speechDuck": {
      "default": 0.28,
      "maximum": 1,
      "minimum": 0,
      "title": "Speechduck",
      "type": "number"
    }
  },
  "required": [
    "id",
    "title",
    "output",
    "style",
    "seed",
    "audioMode",
    "shots",
    "text"
  ],
  "title": "Plan",
  "type": "object"
}
