{
  "schemaVersion": 1,
  "cues": [
    {
      "id": "c1_1",
      "text": "AI，真的把计算机行业干没了吗？",
      "phrases": [
        "AI， zhen de ba ji suan ji hang ye gan mei le ma ？"
      ],
      "meaning": "AI，真的把计算机行业干没了吗？"
    },
    {
      "id": "c2_1",
      "text": "它能批量写代码，",
      "phrases": [
        "ta neng pi liang xie dai ma ，"
      ],
      "meaning": "它能批量写代码，"
    },
    {
      "id": "c2_2",
      "text": "一些重复工作，确实在被压缩。",
      "phrases": [
        "yi xie chong fu gong zuo ， que shi zai bei ya suo 。"
      ],
      "meaning": "一些重复工作，确实在被压缩。"
    },
    {
      "id": "c3_1",
      "text": "但代码生成了，",
      "phrases": [
        "dan dai ma sheng cheng le ，"
      ],
      "meaning": "但代码生成了，"
    },
    {
      "id": "c3_2",
      "text": "不代表产品就能用了。",
      "phrases": [
        "bu dai biao chan pin jiu neng yong le 。"
      ],
      "meaning": "不代表产品就能用了。"
    },
    {
      "id": "c4_1",
      "text": "需求谁来定？",
      "phrases": [
        "xu qiu shui lai ding ？"
      ],
      "meaning": "需求谁来定？"
    },
    {
      "id": "c4_2",
      "text": "数据怎么保？",
      "phrases": [
        "shu ju zen me bao ？"
      ],
      "meaning": "数据怎么保？"
    },
    {
      "id": "c4_3",
      "text": "系统出错，谁来查？",
      "phrases": [
        "xi tong chu cuo ， shui lai cha ？"
      ],
      "meaning": "系统出错，谁来查？"
    },
    {
      "id": "c5_1",
      "text": "这些工作，AI也能帮忙，",
      "phrases": [
        "zhe xie gong zuo ，AI ye neng bang mang ，"
      ],
      "meaning": "这些工作，AI也能帮忙，"
    },
    {
      "id": "c5_2",
      "text": "但结果仍要验证。",
      "phrases": [
        "dan jie guo reng yao yan zheng 。"
      ],
      "meaning": "但结果仍要验证。"
    },
    {
      "id": "c6_1",
      "text": "我的判断：行业正在重组。",
      "phrases": [
        "wo de pan duan ： hang ye zheng zai chong zu 。"
      ],
      "meaning": "我的判断：行业正在重组。"
    },
    {
      "id": "c6_2",
      "text": "会生成代码，也得能交付结果。",
      "phrases": [
        "hui sheng cheng dai ma ， ye de neng jiao fu jie guo 。"
      ],
      "meaning": "会生成代码，也得能交付结果。"
    }
