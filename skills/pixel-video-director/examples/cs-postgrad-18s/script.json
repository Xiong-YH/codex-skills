{
  "schemaVersion": 1,
  "cues": [
    {
      "id": "c1",
      "text": "计算机，要不要考研？",
      "phrases": [
        "ji suan ji",
        "yao bu yao kao yan"
      ],
      "meaning": "提出问题，不先替所有人选择读研或就业。"
    },
    {
      "id": "c2",
      "text": "想做研究，或目标岗位要求硕士，可以考。",
      "phrases": [
        "xiang zuo yan jiu",
        "huo mu biao gang wei yao qiu shuo shi",
        "ke yi kao"
      ],
      "meaning": "研究兴趣和目标岗位的明确学历门槛，是考虑读研的理由；不概括所有岗位。"
    },
    {
      "id": "c3",
      "text": "想尽快就业，先做项目、找实习。",
      "phrases": [
        "xiang jin kuai jiu ye",
        "xian zuo xiang mu",
        "zhao shi xi"
      ],
      "meaning": "以尽快就业为目标时，先积累和验证实践能力。"
    },
    {
      "id": "c4",
      "text": "别跟风，先看目标，再看岗位要求。",
      "phrases": [
        "bie gen feng",
        "xian kan mu biao",
        "zai kan gang wei yao qiu"
      ],
      "meaning": "用个人目标和具体岗位要求倒推路线。"
    }
  ],
