{
  "schemaVersion": 1,
  "cues": [
    {
      "id": "c1",
      "text": "面对多个方案，总想马上选。",
      "phrases": [
        "mian dui duo ge fang an",
        "zong xiang ma shang xuan"
      ],
      "meaning": "先呈现面对多个方案立即选择的冲动，后续镜头再建立选择边界。"
    },
    {
      "id": "c2",
      "text": "先看目标、时间和资源。",
      "phrases": [
        "xian kan mu biao",
        "shi jian he zi yuan"
      ],
      "meaning": "把三个边界变成可见的判定条件。"
    },
    {
      "id": "c3",
      "text": "边界一清楚，选项就变少。",
      "phrases": [
        "bian jie yi qing chu",
        "xuan xiang jiu bian shao"
      ],
      "meaning": "条件逐项筛选，让三个方案收敛成一个。"
    },
    {
      "id": "c4",
      "text": "留下可行方案，迈出第一步。",
      "phrases": [
        "liu xia ke xing fang an",
        "mai chu di yi bu"
      ],
      "meaning": "选择以执行收尾。"
    }
  ],
