{
  "$defs": {
    "FrameRef": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Event",
          "type": "string"
        },
        "offsetFrames": {
          "default": 0,
          "title": "Offsetframes",
          "type": "integer"
        }
      },
      "required": [
        "event"
      ],
      "title": "FrameRef",
      "type": "object"
    },
    "RichText": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "maximum": 1,
          "minimum": 0,
          "title": "Left",
          "type": "number"
        },
        "right": {
          "maximum": 1,
          "minimum": 0,
          "title": "Right",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "size": {
          "anyOf": [
            {
              "maximum": 0.12,
              "minimum": 0.02,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "emphasis": {
          "items": {
            "$ref": "#/$defs/TextEmphasis"
          },
          "title": "Emphasis",
          "type": "array"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        }
      },
      "required": [
        "left",
        "right",
        "y"
      ],
      "title": "RichText",
      "type": "object"
    },
    "TextCue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "subtitle",
            "annotation",
            "title",
            "label"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "phrases": {
          "items": {
            "type": "string"
          },
          "title": "Phrases",
          "type": "array"
        },
        "start": {
          "$ref": "#/$defs/FrameRef"
        },
        "end": {
          "$ref": "#/$defs/FrameRef"
        },
        "accent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accent"
        },
        "richText": {
          "anyOf": [
            {
              "$ref": "#/$defs/RichText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "required": [
        "id",
        "role",
        "text",
        "start",
        "end"
      ],
      "title": "TextCue",
      "type": "object"
    },
    "TextEmphasis": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "treatment": {
          "anyOf": [
            {
              "const": "underline",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Treatment"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextEmphasis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cues": {
      "items": {
        "$ref": "#/$defs/TextCue"
      },
      "title": "Cues",
      "type": "array"
    }
  },
  "title": "Text",
  "type": "object"
}
