{
  "$defs": {
    "ActorPose": {
      "additionalProperties": false,
      "properties": {
        "pose": {
          "enum": [
            "neutral",
            "wave",
            "talk",
            "dazed-left",
            "dazed-right",
            "overwhelmed"
          ],
          "title": "Pose",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/FrameRef"
        },
        "end": {
          "$ref": "#/$defs/FrameRef"
        }
      },
      "required": [
        "pose",
        "start",
        "end"
      ],
      "title": "ActorPose",
      "type": "object"
    },
    "AtlasPose": {
      "additionalProperties": false,
      "properties": {
        "pose": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Pose",
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/FrameRef"
        },
        "sourceRect": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Sourcerect",
          "type": "array"
        },
        "offset": {
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Offset",
          "type": "array"
        }
      },
      "required": [
        "pose",
        "at",
        "sourceRect"
      ],
      "title": "AtlasPose",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "identity",
            "metric",
            "comparison",
            "annotation",
            "chapter",
            "flow",
            "timeline",
            "checklist",
            "hierarchy",
            "bars",
            "code",
            "takeaway"
          ],
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "showEvent": {
          "default": "enter",
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Showevent",
          "type": "string"
        },
        "focusEvent": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focusevent"
        },
        "tone": {
          "default": "gold",
          "enum": [
            "accent",
            "gold",
            "danger",
            "secondary"
          ],
          "title": "Tone",
          "type": "string"
        },
        "visualStyle": {
          "default": "mechanical",
          "enum": [
            "plain",
            "mechanical",
            "energy",
            "paper"
          ],
          "title": "Visualstyle",
          "type": "string"
        },
        "styleVariant": {
          "default": "inset",
          "enum": [
            "open",
            "inset",
            "relay"
          ],
          "title": "Stylevariant",
          "type": "string"
        },
        "features": {
          "items": {
            "const": "stack",
            "type": "string"
          },
          "maxItems": 1,
          "title": "Features",
          "type": "array"
        },
        "entryFrom": {
          "anyOf": [
            {
              "items": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entryfrom"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "x",
        "y",
        "width",
        "height",
        "data"
      ],
      "title": "Component",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "speech": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpeechAnchor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id"
      ],
      "title": "Event",
      "type": "object"
    },
    "FrameRef": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Event",
          "type": "string"
        },
        "offsetFrames": {
          "default": 0,
          "title": "Offsetframes",
          "type": "integer"
        }
      },
      "required": [
        "event"
      ],
      "title": "FrameRef",
      "type": "object"
    },
    "MediaSource": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "kind": {
          "default": "image",
          "enum": [
            "image",
            "video"
          ],
          "title": "Kind",
          "type": "string"
        },
        "fit": {
          "default": "cover",
          "enum": [
            "cover",
            "contain"
          ],
          "title": "Fit",
          "type": "string"
        },
        "anchorX": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchorx",
          "type": "number"
        },
        "anchorY": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchory",
          "type": "number"
        },
        "dim": {
          "default": 0.0,
          "maximum": 0.85,
          "minimum": 0,
          "title": "Dim",
          "type": "number"
        },
        "trimStartSeconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Trimstartseconds",
          "type": "number"
        },
        "shortage": {
          "default": "error",
          "enum": [
            "error",
            "hold"
          ],
          "title": "Shortage",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "MediaSource",
      "type": "object"
    },
    "Motion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "recipe": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Recipe",
          "type": "string"
        },
        "target": {
          "default": "scene",
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Target",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/FrameRef"
        },
        "durationFrames": {
          "exclusiveMinimum": 0,
          "title": "Durationframes",
          "type": "integer"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "id",
        "recipe",
        "start",
        "durationFrames"
      ],
      "title": "Motion",
      "type": "object"
    },
    "NarrativeProgress": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/ProgressNode"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "title": "NarrativeProgress",
      "type": "object"
    },
    "PoseAtlas": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "poses": {
          "items": {
            "$ref": "#/$defs/AtlasPose"
          },
          "maxItems": 120,
          "minItems": 1,
          "title": "Poses",
          "type": "array"
        }
      },
      "required": [
        "file",
        "x",
        "y",
        "height",
        "poses"
      ],
      "title": "PoseAtlas",
      "type": "object"
    },
    "ProgressNode": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 12,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/FrameRef"
        }
      },
      "required": [
        "label",
        "at"
      ],
      "title": "ProgressNode",
      "type": "object"
    },
    "Rehearsal": {
      "additionalProperties": false,
      "properties": {
        "cueIds": {
          "items": {
            "maxLength": 100,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Cueids",
          "type": "array"
        },
        "startFrame": {
          "default": 12,
          "minimum": 0,
          "title": "Startframe",
          "type": "integer"
        },
        "unitsPerSecond": {
          "default": 4.3,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Unitspersecond",
          "type": "number"
        },
        "commaSeconds": {
          "default": 0.18,
          "maximum": 5,
          "minimum": 0,
          "title": "Commaseconds",
          "type": "number"
        },
        "stopSeconds": {
          "default": 0.35,
          "maximum": 5,
          "minimum": 0,
          "title": "Stopseconds",
          "type": "number"
        },
        "gapSeconds": {
          "default": 0.2,
          "maximum": 5,
          "minimum": 0,
          "title": "Gapseconds",
          "type": "number"
        }
      },
      "required": [
        "cueIds"
      ],
      "title": "Rehearsal",
      "type": "object"
    },
    "SceneObject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "asset": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Asset",
          "type": "string"
        },
        "x": {
          "default": 0.65,
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "id",
        "asset"
      ],
      "title": "SceneObject",
      "type": "object"
    },
    "Shot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "beatId": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Beatid"
        },
        "durationFrames": {
          "exclusiveMinimum": 0,
          "title": "Durationframes",
          "type": "integer"
        },
        "scene": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Scene",
          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "actor.azong.v3",
          "title": "Actor"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/SceneObject"
          },
          "title": "Objects",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "title": "Events",
          "type": "array"
        },
        "rehearsal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rehearsal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "motions": {
          "items": {
            "$ref": "#/$defs/Motion"
          },
          "title": "Motions",
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Components",
          "type": "array"
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replacement": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "performance": {
          "items": {
            "$ref": "#/$defs/ActorPose"
          },
          "title": "Performance",
          "type": "array"
        },
        "poseAtlas": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoseAtlas"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "durationFrames",
        "scene"
      ],
      "title": "Shot",
      "type": "object"
    },
    "SpeechAnchor": {
      "additionalProperties": false,
      "properties": {
        "cueId": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Cueid",
          "type": "string"
        },
        "edge": {
          "default": "word",
          "enum": [
            "start",
            "end",
            "word"
          ],
          "title": "Edge",
          "type": "string"
        },
        "word": {
          "default": "",
          "title": "Word",
          "type": "string"
        },
        "occurrence": {
          "default": 0,
          "minimum": 0,
          "title": "Occurrence",
          "type": "integer"
        },
        "offsetFrames": {
          "default": 0,
          "title": "Offsetframes",
          "type": "integer"
        }
      },
      "required": [
        "cueId"
      ],
      "title": "SpeechAnchor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "shots": {
      "items": {
        "$ref": "#/$defs/Shot"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Shots",
      "type": "array"
    },
    "progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/NarrativeProgress"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "shots"
  ],
  "title": "Timeline",
  "type": "object"
}
