{
  "$defs": {
    "Component": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "identity",
            "metric",
            "comparison",
            "annotation",
            "chapter",
            "flow",
            "timeline",
            "checklist",
            "hierarchy",
            "bars",
            "code",
            "takeaway"
          ],
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "showEvent": {
          "default": "enter",
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Showevent",
          "type": "string"
        },
        "focusEvent": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focusevent"
        },
        "tone": {
          "default": "gold",
          "enum": [
            "accent",
            "gold",
            "danger",
            "secondary"
          ],
          "title": "Tone",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "x",
        "y",
        "width",
        "height",
        "data"
      ],
      "title": "Component",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "frame"
      ],
      "title": "Event",
      "type": "object"
    },
    "FrameRef": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Event",
          "type": "string"
        },
        "offsetFrames": {
          "default": 0,
          "title": "Offsetframes",
          "type": "integer"
        }
      },
      "required": [
        "event"
      ],
      "title": "FrameRef",
      "type": "object"
    },
    "MediaSource": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "kind": {
          "default": "image",
          "enum": [
            "image",
            "video"
          ],
          "title": "Kind",
          "type": "string"
        },
        "fit": {
          "default": "cover",
          "enum": [
            "cover",
            "contain"
          ],
          "title": "Fit",
          "type": "string"
        },
        "anchorX": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchorx",
          "type": "number"
        },
        "anchorY": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchory",
          "type": "number"
        },
        "dim": {
          "default": 0.0,
          "maximum": 0.85,
          "minimum": 0,
          "title": "Dim",
          "type": "number"
        },
        "trimStartSeconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Trimstartseconds",
          "type": "number"
        },
        "shortage": {
          "default": "error",
          "enum": [
            "error",
            "hold"
          ],
          "title": "Shortage",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "MediaSource",
      "type": "object"
    },
    "Motion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "recipe": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Recipe",
          "type": "string"
        },
        "target": {
          "default": "scene",
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Target",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/FrameRef"
        },
        "durationFrames": {
          "exclusiveMinimum": 0,
          "title": "Durationframes",
          "type": "integer"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "id",
        "recipe",
        "start",
        "durationFrames"
      ],
      "title": "Motion",
      "type": "object"
    },
    "SceneObject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "asset": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Asset",
          "type": "string"
        },
        "x": {
          "default": 0.65,
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "id",
        "asset"
      ],
      "title": "SceneObject",
      "type": "object"
    },
    "Shot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "durationFrames": {
          "exclusiveMinimum": 0,
          "title": "Durationframes",
          "type": "integer"
        },
        "scene": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Scene",
          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "actor.azong.v3",
          "title": "Actor"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/SceneObject"
          },
          "title": "Objects",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "title": "Events",
          "type": "array"
        },
        "motions": {
          "items": {
            "$ref": "#/$defs/Motion"
          },
          "title": "Motions",
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Components",
          "type": "array"
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replacement": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "durationFrames",
        "scene"
      ],
      "title": "Shot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "shots": {
      "items": {
        "$ref": "#/$defs/Shot"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Shots",
      "type": "array"
    }
  },
  "required": [
    "shots"
  ],
  "title": "Timeline",
  "type": "object"
}
