{
  "$defs": {
    "AudioCue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "sound": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sound"
        },
        "file": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "at": {
          "$ref": "#/$defs/FrameRef"
        },
        "level": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Level",
          "type": "number"
        },
        "x": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "variant": {
          "default": 0,
          "minimum": 0,
          "title": "Variant",
          "type": "integer"
        },
        "params": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "integer"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "type": "array"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Params"
        },
        "align": {
          "anyOf": [
            {
              "enum": [
                "start",
                "peak",
                "end"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Align"
        }
      },
      "required": [
        "id",
        "at"
      ],
      "title": "AudioCue",
      "type": "object"
    },
    "Bgm": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "default": "bgm",
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/FrameRef"
        },
        "end": {
          "$ref": "#/$defs/FrameRef"
        },
        "gain": {
          "default": 0.18,
          "maximum": 1,
          "minimum": 0,
          "title": "Gain",
          "type": "number"
        },
        "loop": {
          "default": true,
          "title": "Loop",
          "type": "boolean"
        },
        "trimStartSeconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Trimstartseconds",
          "type": "number"
        },
        "fadeInFrames": {
          "default": 60,
          "minimum": 0,
          "title": "Fadeinframes",
          "type": "integer"
        },
        "fadeOutFrames": {
          "default": 90,
          "minimum": 0,
          "title": "Fadeoutframes",
          "type": "integer"
        },
        "speechDuck": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Speechduck",
          "type": "number"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "artist": {
          "default": "",
          "title": "Artist",
          "type": "string"
        },
        "sourceUrl": {
          "default": "",
          "title": "Sourceurl",
          "type": "string"
        },
        "licenseUrl": {
          "default": "",
          "title": "Licenseurl",
          "type": "string"
        },
        "changes": {
          "default": "",
          "title": "Changes",
          "type": "string"
        }
      },
      "required": [
        "file",
        "at",
        "end"
      ],
      "title": "Bgm",
      "type": "object"
    },
    "FrameRef": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Event",
          "type": "string"
        },
        "offsetFrames": {
          "default": 0,
          "title": "Offsetframes",
          "type": "integer"
        }
      },
      "required": [
        "event"
      ],
      "title": "FrameRef",
      "type": "object"
    },
    "NarrationCue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/FrameRef"
        },
        "gain": {
          "default": 0.9,
          "maximum": 1,
          "minimum": 0,
          "title": "Gain",
          "type": "number"
        }
      },
      "required": [
        "id",
        "file",
        "at"
      ],
      "title": "NarrationCue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cues": {
      "items": {
        "$ref": "#/$defs/AudioCue"
      },
      "title": "Cues",
      "type": "array"
    },
    "narration": {
      "items": {
        "$ref": "#/$defs/NarrationCue"
      },
      "title": "Narration",
      "type": "array"
    },
    "speechDuck": {
      "default": 0.28,
      "maximum": 1,
      "minimum": 0,
      "title": "Speechduck",
      "type": "number"
    },
    "masterGain": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 4,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mastergain"
    },
    "bgm": {
      "anyOf": [
        {
          "$ref": "#/$defs/Bgm"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "Audio",
  "type": "object"
}
