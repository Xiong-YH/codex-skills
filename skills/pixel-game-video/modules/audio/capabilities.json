{
  "schemaVersion": 1,
  "defaults": {
    "references": {
      "documentation": [
        "modules/audio/ARCADE.md",
        "modules/audio/GARDEN.md",
        "modules/audio/SYNTHESIS.md",
        "modules/audio/details.md"
      ],
      "examples": [
        "modules/audio/preview.html"
      ],
      "tests": [
        "tests/test_audio_baseline.py",
        "tests/test_game_audio.py",
        "tests/test_synth_sfx.py",
        "tests/test_workbench_bridge.py"
      ]
    },
    "notes": [
      "Garden 合成、街机母版和旧版兼容音色分别列出。工作台使用本次混音的独立 PCM 片段，修改后按当前版本复听。"
    ]
  },
  "features": [
    {
      "id": "audio.sfx-import.v1",
      "title": "项目音效导入与事件对齐",
      "status": "workflow",
      "invocation": "audio.cues[].file + at",
      "references": {
        "documentation": ["modules/audio/SYNTHESIS.md"],
        "examples": [],
        "tests": ["tests/test_synth_sfx.py"]
      },
      "workbench": {"editing": "audio-track", "track": "sfx", "independentTrack": true, "export": "via-track"}
    },
    {
      "id": "audio.garden-score.v1",
      "title": "Garden score、分 bus 与声音技术检查",
      "status": "workflow",
      "invocation": "node modules/audio/vendor/garden-skills/scripts/audio.mjs build|beats|check",
      "references": {
        "documentation": ["modules/audio/GARDEN.md", "modules/audio/vendor/garden-skills/references/sound.md"],
        "examples": ["modules/audio/vendor/garden-skills/assets/starter/score.mjs"],
        "tests": []
      },
      "notes": ["可选原版 Tone 路径按其 package-lock 安装。score 产出的 bus 可转换 PCM 后导入工作台。"],
      "workbench": {"editing": "not-integrated", "track": null, "independentTrack": false, "export": "not-integrated"}
    },
    {
      "id": "audio.narration-import.v1",
      "title": "已有旁白导入与混音",
      "status": "workflow",
      "invocation": "audio.narration[]; project.audioMode=narration+sfx",
      "references": {
        "documentation": [
          "modules/audio/details.md"
        ],
        "examples": [],
        "tests": [
          "tests/test_cache_narration.py",
          "tests/test_workbench_bridge.py"
        ]
      },
      "notes": [
        "导入项目内 PCM WAV，不生成新配音。"
      ],
      "workbench": {
        "editing": "audio-track",
        "track": "narration",
        "independentTrack": true,
        "export": "via-track"
      }
    },
    {
      "id": "audio.bgm-mix.v1",
      "title": "配乐导入与混音",
      "status": "workflow",
      "invocation": "video.py import-bgm PROJECT; audio.bgm",
      "references": {
        "documentation": [
          "modules/audio/MUSIC.md"
        ],
        "examples": [],
        "tests": [
          "tests/test_bgm_contract.py",
          "tests/test_bgm_mix.py"
        ]
      },
      "notes": [
        "支持音量、淡化、循环与旁白压低；Chill Wave 来源与署名保存在原音乐元数据中。"
      ],
      "workbench": {
        "editing": "audio-track",
        "track": "bgm",
        "independentTrack": true,
        "export": "via-track"
      }
    },
    {
      "id": "audio.tts.v1",
      "title": "通用配音生成",
      "status": "not_implemented",
      "invocation": "No TTS executor",
      "references": {
        "documentation": [
          "modules/audio/details.md"
        ],
        "examples": [],
        "tests": []
      },
      "notes": [
        "音色参考与旁白导入不构成 TTS 能力。"
      ]
    }
  ]
}
