  "segments": [
    {
      "start": 0,
      "end": 3.8,
      "text": "AI 都能写代码了，程序员该往哪里走？",
      "accent": "往哪里走"
    },
    {
      "start": 3.8,
      "end": 7.7,
      "text": "把重复实现交给 AI，把精力留给判断。",
      "accent": "判断"
    },
    {
      "start": 7.7,
      "end": 11.7,
      "text": "先问清楚：谁的问题，怎样才算解决？",
      "accent": "谁的问题"
    },
    {
      "start": 11.7,
      "end": 15.7,
      "text": "再画出系统，理清数据和模块的关系。",
      "accent": "系统"
    },
    {
      "start": 15.7,
      "end": 19.9,
      "text": "代码跑通之后，还要验证异常和边界。",
      "accent": "异常和边界"
    },
    {
      "start": 19.9,
      "end": 24.1,
      "text": "让 AI 提方案，由你取舍，对交付负责。",
      "accent": "对交付负责"
    },
    {
      "start": 24.1,
      "end": 28.2,
      "text": "从一个小项目开始，练需求、设计和验证。",
      "accent": "小项目"
    },
    {
      "start": 28.2,
      "end": 32,
      "text": "把会写代码，升级成能解决问题。",
      "accent": "解决问题"
    }
  ]
