# Version repository sources and explicitly selected project directories.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/CHANGELOG.md
!/LICENSE
!/LICENSE.*
!/NOTICE
!/skills/

# Generated files and local dependencies, including inside a skill.
__pycache__/
*.py[cod]
node_modules/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.playwright/
ms-playwright/
browser-profile*/
.env
.env.*
!.env.example
build/
outputs/
sfx-bank/
*.exe
*.dll
*.pyd
*.so
*.dylib
*.mp4
*.mov
*.webm
*.zip
*.log
.DS_Store
Thumbs.db
.segment-cache/

# Local work and the portable catalogue instructions.
!/work/
/work/*
!/work/README.md
!/work/catalog/
/work/catalog/local.json
!/work/art-of-asking-20261107/

# Local staging for tasks outside video production.
/scratch/

# Reference videos live outside the work directory.
!/references/
/references/*
!/references/README.md
!/references/cache-route-canvas/
/references/**/.tmp/
/references/**/exports/
/references/**/frames/
/references/**/profile*/

# Local builds, caches and renders within any selected project.
/work/**/.tmp/
/work/**/.workbench/
/work/**/exports/
/work/**/frames/
/work/**/dist/
/work/**/renders/
/work/**/profile*/
/work/**/*.tmp

# Approved PNG/JPG assets and PCM WAV masters/example narration are skill
# dependencies: keep them versioned rather than ignoring all binary media.

# User-approved lightweight design favorites. Media stays excluded.
!/collections/
/collections/*
!/collections/favorites/
/collections/favorites/*
!/collections/favorites/catalog.json
!/collections/favorites/README.md

# Version the review workbench source and its lightweight poster only.
!/docs/
/docs/*
!/docs/prototypes/
/docs/prototypes/*
!/docs/prototypes/segment-review/
/docs/prototypes/segment-review/*
!/docs/prototypes/segment-review/*.html
!/docs/prototypes/segment-review/*.css
